{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nazarene-for-she",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-19",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "nazarene-for-she"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nazarene-for-she",
      "database_id": "63e259fd-8c15-4be5-95be-8c23013ff831",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "nazarene-for-she-media"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  // Cloudflare Images: lets OpenNext resize next/image requests (AVIF/WebP per screen width)
  // instead of sending the original file to every device.
  "images": {
    "binding": "IMAGES"
  },
  // The site's own domain (bought on Cloudflare). Deploy attaches it to this Worker and creates
  // the DNS records; www is redirected to the bare domain in next.config.ts.
  "routes": [
    { "pattern": "nazareneforshe.org", "custom_domain": true },
    { "pattern": "www.nazareneforshe.org", "custom_domain": true }
  ],
  // Cloudflare Email Service: every email the site sends (contact, donations, shop, documents,
  // password reset). The sender domain must be onboarded under Compute → Email Service.
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "vars": {
    // Sender on the domain onboarded under Compute → Email Service. Empty = no mail.
    "CONTACT_FROM": "Nazarene for She <noreply@nazareneforshe.org>",
    // Organisation inbox for contact, donation and shop notes.
    "CONTACT_INBOX": "nazareneforshe@gmail.com"
  }
}

