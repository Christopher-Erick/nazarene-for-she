NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=nazareneforshe@gmail.com
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_YOUTUBE_URL=
NEXT_PUBLIC_TIKTOK_URL=

# Mail is sent only through Cloudflare Email Service (the EMAIL send_email binding in
# wrangler.jsonc): contact form, donation notes, shop orders, document-desk pings and
# admin "Forgot password" links. No third-party provider, no API key.
# In production these two are set under "vars" in wrangler.jsonc.
# Sender on a domain onboarded in Cloudflare → Email Service → Email Sending:
CONTACT_FROM=
# Organisation inbox for contact, donation and shop notes:
CONTACT_INBOX=

# Document sketches use the Workers AI binding in wrangler.jsonc (free daily neurons).
# No extra key is required once the worker is deployed. Local sketches need Wrangler login.

# Official payment details should be edited in the CMS (Donations) or
# lib/data/donation.ts until the organisation confirms them. Do not invent
# paybill or account numbers.

# Digits only with country code, e.g. 2547XXXXXXXX.
# Enables Order via WhatsApp at checkout. Leave empty to hide that action,
# unless a workshop WhatsApp number is saved in Organization in the CMS.
WHATSAPP_NUMBER=

# CMS / Cloudflare D1
# Create a long random token. Used once to create the first Super Admin.
# POST /api/v1/admin/bootstrap with header x-bootstrap-token.
CMS_BOOTSTRAP_TOKEN=
# Emergency public maintenance (503). Super Admin can also toggle maintenance in D1.
CMS_MAINTENANCE=
